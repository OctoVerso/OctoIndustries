{
  "name": "octo-industries-github-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "pages:build": "node scripts/build-pages-site.mjs",
    "codespace:clean": "node scripts/clean-codespace.mjs",
    "dev:preview": "node scripts/local-staging-preview.mjs start",
    "dev:preview:credentials": "node scripts/local-staging-preview.mjs credentials",
    "dev:preview:reset": "node scripts/local-staging-preview.mjs reset",
    "test": "node --test \"supabase/functions/_shared/*.test.mjs\"",
    "test:frontend": "node --test \"Octo-Industries/BehindTheScenes/**/*.test.mjs\" \"Octo-Industries/PvZ2/tests/*.test.mjs\" \"functions/_lib/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:frontend && npm run test:tooling",
    "test:tooling": "node --test \"scripts/*.test.mjs\"",
    "check": "node scripts/check-source.mjs",
    "security:scan": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "esbuild": "0.28.2",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
