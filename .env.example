# ---- Supabase Edge Function secrets (set with: supabase secrets set --env-file .env) ----
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically; never put the service-role key in the browser or in git.
ADMIN_SESSION_SECRET=              # random string, 32+ characters (openssl rand -hex 32)
OCTO_ADMIN_PASSWORD_HASH=          # output of: npm --prefix Octo-Industries/BehindTheScenes run admin:hash
ALLOWED_ORIGIN=https://nv24191.github.io   # comma-separated browser origins allowed to call the functions
SITE_URL=https://nv24191.github.io/Personal/   # public GitHub Pages URL (used by game health checks)
GEMINI_API_KEY=                    # optional: admin Octo AI chat
OCTO_GEMINI_MODEL=gemini-3.1-flash-lite
GITHUB_TOKEN=                      # optional: lets approved proposals open pull requests
GITHUB_REPOSITORY=nv24191/Personal

# ---- GitHub repository settings ----
# Variable  SUPABASE_FUNCTIONS_URL = https://<project-ref>.supabase.co/functions/v1   (Pages build)
# Variable  SUPABASE_PROJECT_REF   = <project-ref>                                     (functions deploy)
# Secret    SUPABASE_ACCESS_TOKEN  = personal access token from supabase.com/dashboard/account/tokens
