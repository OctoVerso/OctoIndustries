{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Isolated Admin Preview",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:preview",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Open the forwarded port-8080 dashboard at /Octo-Industries/BehindTheScenes/admin/\\.",
        "uriFormat": "http://localhost:8080/Octo-Industries/BehindTheScenes/admin/",
        "action": "openExternally"
      }
    }
  ]
}
